# Absolute origin used for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# Falls back to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
SITE_URL=https://www.example.com

# Set to "true" only after the owner approves launch. While false (the default) every page
# carries noindex,nofollow and robots.txt disallows all crawling.
# The build fails if this is "true" while SITE_URL still points at localhost.
SITE_INDEXABLE=false
